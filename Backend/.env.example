# Server Port Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB ATLAS URI)
MONGO_URI=ATLAS_URI

# Client CORS Allowed Origin
FRONTEND_URL=http://localhost:5173

# Cryptographic Token Secrets (Must be long, random strings in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_sample_key_change_me
JWT_REFRESH_SECRET=your_jwt_refresh_secret_sample_key_change_me

# CLoudinary Configuration for Image Uploads
CLOUDINARY_CLOUD_NAME = 
CLOUDINARY_API_KEY = 
CLOUDINARY_API_SECRET = 

# Redis Configuration for Caching
REDIS_URL=redis://redis:6379

# Firebase Service Account Configuration (Base64 Encoded)
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Required META Credentials
APP_ID=
APP_SECRET=
PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_PAGE_ID=

# Cloudflare Configuration for Image Generation
CF_ACCOUNT_ID=
CF_API_TOKEN=

# AWS Credentials Required for S3 Bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS EC2 Configuration for Deployment
AWS_EC2_HOST=
AWS_EC2_SSH_KEY=

